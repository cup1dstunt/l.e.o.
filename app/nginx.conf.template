# L.E.O. Prototyp. Vorlage: Beim Start setzt das nginx-Image ${UNTIS_SERVER}, ${ISERV_SERVER} und ${NGINX_LOCAL_RESOLVERS} ein.
server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;

  # nginx liefert die App-Dateien aus. Noten liegen nur verschlüsselt beim Abgleich-Dienst (F4).
  location / {
    try_files $uri $uri/ /index.html;
    add_header Cache-Control "no-cache";
  }
  # Dateien mit Versions-Hash dürfen lange im Cache bleiben
  location /_app/immutable/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
  }
  location = /service-worker.js { add_header Cache-Control "no-cache"; }

  # Selbsteinschätzung der Schüler (FB7b, E116): eigenständige Seite, Token steht hinter # und erreicht den Server nie.
  location /e/ {
    try_files $uri $uri/index.html =404;
    add_header Cache-Control "no-store" always;
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Content-Type-Options nosniff always;
    add_header Content-Security-Policy "default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'unsafe-inline'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;
  }

  # Abgleich-Dienst (F4) im selben Container. Bekommt nur verschlüsselte Datensätze.
  location /abgleich/ {
    access_log off;
    proxy_pass http://127.0.0.1:8129;
    proxy_set_header X-Forwarded-For "";
    proxy_buffering off;
    proxy_read_timeout 60s;
    client_max_body_size 16m;
    add_header Cache-Control "no-store" always;
  }

  # Durchreicher zu WebUntis (V11): gleiche Adresse für den Browser, daher kein CORS-Problem.
  # Reicht nur durch: kein Zwischenspeicher, kein Zugriffsprotokoll, keine Daten auf dem Server.
  location /WebUntis/ {
    access_log off;
    resolver ${NGINX_LOCAL_RESOLVERS} valid=300s ipv6=off;
    resolver_timeout 5s;
    set $untis https://${UNTIS_SERVER};
    proxy_pass $untis;
    proxy_ssl_server_name on;
    proxy_ssl_name ${UNTIS_SERVER};
    proxy_ssl_verify on;
    proxy_ssl_verify_depth 3;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    proxy_set_header Host ${UNTIS_SERVER};
    proxy_set_header Origin https://${UNTIS_SERVER};
    proxy_set_header Referer https://${UNTIS_SERVER}/WebUntis/;
    proxy_set_header X-Forwarded-For "";
    proxy_set_header X-Real-IP "";
    # Cookies der Sitzung für diese Adresse umschreiben; über http://IP ohne HTTPS darf "Secure" nicht gesetzt sein
    proxy_cookie_domain ~.+ $host;
    proxy_cookie_flags ~ nosecure samesite=lax;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 30s;
    client_max_body_size 256k;
    add_header Cache-Control "no-store" always;
  }

  # Durchreicher zum IServ-Kalender (V17): nur lesen (GET), nur an ISERV_SERVER, ohne Cookies und ohne Protokoll.
  # Der Abo-Link enthält einen geheimen Schlüssel; er steht im Pfad und wird deshalb nirgends protokolliert.
  location = /iserv-server {
    access_log off;
    default_type text/plain;
    add_header Cache-Control "no-store" always;
    return 200 "${ISERV_SERVER}";
  }
  location /iserv/ {
    access_log off;
    set $iserv_host "${ISERV_SERVER}";
    if ($iserv_host = "") { return 404; }
    limit_except GET { deny all; }
    resolver ${NGINX_LOCAL_RESOLVERS} valid=300s ipv6=off;
    resolver_timeout 5s;
    rewrite ^/iserv/(.*)$ /$1 break;
    proxy_pass https://$iserv_host;
    proxy_ssl_server_name on;
    proxy_ssl_name $iserv_host;
    proxy_ssl_verify on;
    proxy_ssl_verify_depth 3;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    proxy_set_header Host $iserv_host;
    proxy_set_header Cookie "";
    proxy_set_header Authorization "";
    proxy_set_header Referer "";
    proxy_set_header X-Forwarded-For "";
    proxy_set_header X-Real-IP "";
    proxy_hide_header Set-Cookie;
    proxy_buffering on;
    proxy_cache off;
    proxy_read_timeout 30s;
    proxy_max_temp_file_size 0;
    client_max_body_size 1k;
    add_header Cache-Control "no-store" always;
  }

  # CalDAV zu IServ (E120): für Kalender ohne Feed-Link (z. B. OSZ-Info). Nur lesen (GET, REPORT, PROPFIND), nur /caldav/
  # an ISERV_SERVER. Die Anmeldung (Authorization) wird durchgereicht, aber nie protokolliert oder gespeichert.
  # WWW-Authenticate wird entfernt, damit der Browser kein eigenes Anmeldefenster zeigt.
  location /iserv-caldav/ {
    access_log off;
    set $iserv_host "${ISERV_SERVER}";
    if ($iserv_host = "") { return 404; }
    if ($request_method !~ ^(GET|REPORT|PROPFIND)$) { return 405; }
    resolver ${NGINX_LOCAL_RESOLVERS} valid=300s ipv6=off;
    resolver_timeout 5s;
    rewrite ^/iserv-caldav/(.*)$ /caldav/$1 break;
    proxy_pass https://$iserv_host;
    proxy_ssl_server_name on;
    proxy_ssl_name $iserv_host;
    proxy_ssl_verify on;
    proxy_ssl_verify_depth 3;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    proxy_set_header Host $iserv_host;
    proxy_set_header Cookie "";
    proxy_set_header Referer "";
    proxy_set_header X-Forwarded-For "";
    proxy_set_header X-Real-IP "";
    proxy_hide_header Set-Cookie;
    proxy_hide_header WWW-Authenticate;
    proxy_buffering on;
    proxy_cache off;
    proxy_read_timeout 30s;
    proxy_max_temp_file_size 0;
    client_max_body_size 8k;
    add_header Cache-Control "no-store" always;
  }

  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy no-referrer always;
  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml application/manifest+json;
}
